# Meta Ad Library API token: developers.facebook.com -> app -> Graph API Explorer (needs ID check at facebook.com/ID)
META_TOKEN=
# Optional free local LLM that reads every new advertised domain; host.docker.internal = your PC from a container
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# 0 = run the model on CPU only; 99 = all of it on the GPU (empty let Ollama put only 21 of 29 layers on a 4 GB card)
OLLAMA_NUM_GPU=99
# GUS REGON (BIR1.1) key, free, ordered from GUS: NIP checks ask REGON first, the MF VAT list without it
GUS_KEY=
# CEIDG token, free from dane.biznes.gov.pl: the panel's check shows a sole trader's status, start date and main trade
CEIDG_TOKEN=
# Server only: home's relay (home.py) through the SSH tunnel from home, e.g. http://host.docker.internal:8765; empty at home
HOME_URL=
# Same on the server and at home, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOME_TOKEN=
